# Copy to .env and fill in only what you use. .env is git-ignored.
# Secrets live here, never in config.yaml.

# LLM keys (only for cloud providers; Ollama / LM Studio need none)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Required only if you expose the server beyond localhost (server.host != 127.0.0.1).
# Then open the UI as http://HOST:8765/?token=YOUR_TOKEN
RIKO_AUTH_TOKEN=

# Optional: folder of your GPT-SoVITS install; start.bat / start.sh will launch its API for you.
GPT_SOVITS_DIR=
